{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app5",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "38748adb-a809-45fb-a368-15af2b40623a","database_name": "web-app5" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "a7093d4f012f447b9731314c31e6ccee" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
